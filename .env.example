POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-long-random-password
NEO4J_PASSWORD=replace-with-a-long-random-password
AI_SERVICE_TOKEN=replace-with-a-long-random-service-token
BOOTSTRAP_ADMIN_EMAIL=admin@nexus.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-random-characters
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

# Server-only optional hosted inference. Never place these in NEXT_PUBLIC variables.
GROQ_API_KEY=
GROQ_ENABLED=true
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_DAILY_REQUEST_BUDGET=100
SITE_URL=http://localhost:3000
HTTPS_DEPLOYMENT=false
# Public DNS hostname used only with docker-compose.oracle.yml (no scheme/path).
NEXUS_HOSTNAME=
# Genuine operator email or contact URL for programmatic research identification.
NEXUS_RESEARCH_CONTACT=
